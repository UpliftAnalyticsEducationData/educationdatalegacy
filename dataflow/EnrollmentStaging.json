{
	"name": "EnrollmentStaging",
	"properties": {
		"folder": {
			"name": "Enrollment"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "stagingEnrollment14_24",
						"type": "DatasetReference"
					},
					"name": "Enrollment14to24"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "EducationData",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          SchoolYear as string,",
				"          OrganizationLevel as string,",
				"          County as string,",
				"          ESDName as string,",
				"          ESDOrganizationID as string,",
				"          DistrictCode as string,",
				"          DistrictName as string,",
				"          DistrictOrganizationId as string,",
				"          SchoolCode as string,",
				"          SchoolName as string,",
				"          SchoolOrganizationid as string,",
				"          CurrentSchoolType as string,",
				"          Gradelevel as string,",
				"          {All Students} as integer,",
				"          Female as integer,",
				"          Male as integer,",
				"          {Gender X} as integer,",
				"          {American Indian/ Alaskan Native} as integer,",
				"          Asian as integer,",
				"          {Black/ African American} as integer,",
				"          {Hispanic/ Latino of any race(s)} as integer,",
				"          {Native Hawaiian/ Other Pacific Islander} as integer,",
				"          {Two or More Races} as integer,",
				"          White as integer,",
				"          {English Language Learners} as integer,",
				"          {Highly Capable} as integer,",
				"          Homeless as integer,",
				"          {Low-Income} as integer,",
				"          Migrant as integer,",
				"          {Military Parent} as integer,",
				"          Mobile as integer,",
				"          {Section 504} as integer,",
				"          {Students with Disabilities} as integer,",
				"          {Non-English Language Learners} as integer,",
				"          {Non-Highly Capable} as integer,",
				"          {Non-Homeless} as integer,",
				"          {Non-Low Income} as integer,",
				"          {Non Migrant} as integer,",
				"          {Non Military Parent} as integer,",
				"          {Non Mobile} as integer,",
				"          {Non Section 504} as integer,",
				"          {Students without Disabilities} as integer,",
				"          FosterCare as integer,",
				"          {Non-FosterCare} as integer,",
				"          {{DataAsOf} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Enrollment14to24",
				"Enrollment14to24 select(mapColumn(",
				"          SchoolYear,",
				"          OrganizationLevel,",
				"          County,",
				"          ESDName,",
				"          ESDOrganizationID,",
				"          DistrictCode,",
				"          DistrictName,",
				"          DistrictOrganizationId,",
				"          SchoolCode,",
				"          SchoolName,",
				"          SchoolOrganizationId = SchoolOrganizationid,",
				"          CurrentSchoolType,",
				"          GradeLevel = Gradelevel,",
				"          {All Students},",
				"          Female,",
				"          Male,",
				"          {Gender X},",
				"          {American Indian/ Alaskan Native},",
				"          Asian,",
				"          {Black/ African American},",
				"          {Hispanic/ Latino of any race(s)},",
				"          {Native Hawaiian/ Other Pacific Islander},",
				"          {Two or More Races},",
				"          White,",
				"          {English Language Learners},",
				"          {Highly Capable},",
				"          Homeless,",
				"          {Low-Income},",
				"          Migrant,",
				"          Military = {Military Parent},",
				"          Mobile,",
				"          {Section 504},",
				"          {Students with Disabilities},",
				"          {Non-English Language Learners},",
				"          {Non-Highly Capable},",
				"          {Non-Homeless},",
				"          {Non-Low Income},",
				"          {Non-Migrant} = {Non Migrant},",
				"          {Non-Military} = {Non Military Parent},",
				"          {Non-Mobile} = {Non Mobile},",
				"          {Non-Section 504} = {Non Section 504},",
				"          {Students without Disabilities},",
				"          DataAsOf = {{DataAsOf},",
				"          {Foster Care} = FosterCare,",
				"          {Non-Foster Care} = {Non-FosterCare}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'staging',",
				"     tableName: 'Enrollment',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     recreate: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}